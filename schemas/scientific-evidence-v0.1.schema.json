{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxkybernetica.org/schemas/scientific-evidence-v0.1.schema.json",
  "title": "NC × Lux scientific evidence layer v0.1",
  "type": "object",
  "required": ["id", "version", "scope", "policy", "studies"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "scope": {"type": "string"},
    "policy": {"type": "array", "items": {"type": "string"}},
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "citation", "year", "evidence_class", "domain", "source_locator", "design_summary", "findings", "nc_links", "limitations", "does_not_establish"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
          "citation": {"type": "string"},
          "year": {"type": "integer", "minimum": 1900},
          "evidence_class": {"enum": ["primary_experimental", "primary_observational", "case_report", "systematic_review", "narrative_review", "methodological_study"]},
          "domain": {"type": "array", "items": {"type": "string"}},
          "source_locator": {
            "type": "object",
            "properties": {
              "doi": {"type": ["string", "null"]},
              "pmid": {"type": ["string", "null"]},
              "pmcid": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "design_summary": {"type": "string"},
          "findings": {"type": "array", "items": {"type": "string"}},
          "nc_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["nc_ref", "relation", "basis"],
              "properties": {
                "nc_ref": {"type": "string", "pattern": "^nova\\.[a-z0-9_]+$"},
                "relation": {"enum": ["experimental_analogue", "mechanistic_context", "clinical_context", "phenomenology_context", "measurement_precedent", "operationalization_support", "alternative_explanation"]},
                "basis": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "limitations": {"type": "array", "items": {"type": "string"}},
          "does_not_establish": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
